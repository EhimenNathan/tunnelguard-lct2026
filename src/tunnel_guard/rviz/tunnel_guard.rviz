Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 60
      Color: 55; 55; 65
      Offset:
        X: 150
        Y: 0
        Z: -2
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar (TunnelGuard view - grey by range, yellow near envelope, red inside, magenta obstacle)
      Enabled: true
      Topic:
        Value: /tunnel_guard/cloud
        Reliability Policy: Best Effort
        Depth: 2
      Style: Points
      Size (Pixels): 2
      Color Transformer: RGB8
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Obstacle points
      Enabled: true
      Topic:
        Value: /tunnel_guard/obstacle_points
      Style: Points
      Size (Pixels): 6
      Color Transformer: FlatColor
      Color: 255; 0; 255
    - Class: rviz_default_plugins/MarkerArray
      Name: Envelope, obstacles, dust, distances, status
      Enabled: true
      Topic:
        Value: /tunnel_guard/markers
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
  Global Options:
    Background Color: 18; 18; 26
    Fixed Frame: tunnel_guard
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Behind the train
      Target Frame: <Fixed Frame>
      Distance: 62
      Pitch: 0.28
      Yaw: 3.1416
      Focal Point:
        X: 45
        Y: 0
        Z: 0
      Near Clip Distance: 0.1
Window Geometry:
  Width: 1600
  Height: 900
