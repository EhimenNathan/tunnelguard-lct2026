# Локальный рабочий стол в браузере для Linux/Windows/macOS с уже установленным Docker.
ARG TG_BASE=ghcr.io/ehimennathan/tunnel_guard:latest
FROM ${TG_BASE}
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb x11-utils x11vnc novnc websockify openbox xterm fonts-dejavu-core imagemagick \
    && rm -rf /var/lib/apt/lists/*
COPY docker/gui.sh /usr/local/bin/tg-gui
RUN chmod +x /usr/local/bin/tg-gui
ENV DISPLAY=:99 LP_NUM_THREADS=1 LIBGL_ALWAYS_SOFTWARE=1 TG_VNC_PASSWORD=tunnelguard TG_GUI_AUTOSTART=1
EXPOSE 6080
HEALTHCHECK --interval=10s --start-period=30s CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:6080/vnc.html',timeout=3)" || exit 1
ENTRYPOINT ["/usr/local/bin/tg-gui"]
